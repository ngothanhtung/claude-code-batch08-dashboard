rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /tasks/{taskId} {
      function signedIn() {
        return request.auth != null;
      }

      function isCreator() {
        return resource.data.createdBy == request.auth.uid;
      }

      function isAssignee() {
        return resource.data.assigneeEmail != null
          && resource.data.assigneeEmail == request.auth.token.get('email', '').lower();
      }

      function isValidTask(data) {
        return data.title is string
          && data.title.size() > 0
          && data.title.size() <= 200
          && data.status in ['todo', 'in_progress', 'done']
          && data.priority in ['low', 'medium', 'high'];
      }

      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && isValidTask(request.resource.data);

      // The creator or the assignee may edit, but never change who created it.
      allow update: if signedIn()
        && (isCreator() || isAssignee())
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdByEmail == resource.data.createdByEmail
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidTask(request.resource.data);

      allow delete: if signedIn() && isCreator();
    }

    // Public profiles, written by each user on sign-in (see users.service.ts).
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid;
    }

    // Revenue figures ({ year, month, value }), managed in the Firebase Console.
    match /revenues/{revenueId} {
      allow read: if request.auth != null;
    }

    // Chat rooms (see chat.service.ts). Only members can see or post.
    match /conversations/{conversationId} {
      function signedIn() {
        return request.auth != null;
      }

      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'memberIds',
          'createdBy', 'createdTime', 'lastMessage', 'lastSender', 'updatedTime'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() >= 2
        && request.resource.data.memberIds.size() <= 50
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.members is list
        && request.resource.data.members.size() == request.resource.data.memberIds.size()
        && request.resource.data.createdTime == request.time
        && request.resource.data.updatedTime == request.time
        && request.resource.data.lastMessage == null;

      // Members may only bump the last-message preview (done with each message).
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastSender', 'updatedTime'])
        && request.resource.data.lastSender == request.auth.uid
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.updatedTime == request.time;

      match /messages/{messageId} {
        function isMember() {
          return request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
        }

        allow read: if signedIn() && isMember();

        // Mirrors MAX_MESSAGE_LENGTH and MAX_ATTACHMENTS in
        // src/features/chat/types.ts. Text, attachments, or both. Immutable.
        allow create: if signedIn()
          && isMember()
          && request.resource.data.keys().hasOnly(['sender', 'content', 'attachments', 'createdTime'])
          && request.resource.data.sender == request.auth.uid
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 2000
          && request.resource.data.get('attachments', []) is list
          && request.resource.data.get('attachments', []).size() <= 10
          && (request.resource.data.content.size() > 0
            || request.resource.data.get('attachments', []).size() > 0)
          && request.resource.data.createdTime == request.time;
      }
    }

    // Gameshow (see gameshow.service.ts). Roles live in games/{id}.roles.
    // Contestants never read questions (the answer key); they only see what
    // the director copies into live/state.
    match /games/{gameId} {
      function signedIn() {
        return request.auth != null;
      }

      function gameData() {
        return get(/databases/$(database)/documents/games/$(gameId)).data;
      }

      function role() {
        return gameData().roles.get(request.auth.uid, null);
      }

      function isDirector() {
        return signedIn() && role() == 'director';
      }

      function isStaff() {
        return signedIn() && role() in ['director', 'mc', 'judge'];
      }

      function isMember() {
        return signedIn() && role() != null;
      }

      function live() {
        return get(/databases/$(database)/documents/games/$(gameId)/live/state).data;
      }

      function isValidGame(data) {
        return data.title is string
          && data.title.size() > 0
          && data.title.size() <= 200
          && data.roles is map
          && data.roles.values().toSet().hasOnly(
            ['director', 'mc', 'judge', 'contestant', 'display'])
          && data.memberIds is list
          && data.memberIds.size() == data.roles.size()
          && data.memberIds.toSet().hasAll(data.roles.keys())
          // The editor keeps the director role, so a game is never orphaned.
          && data.roles.get(request.auth.uid, null) == 'director';
      }

      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && isValidGame(request.resource.data);

      allow update: if signedIn()
        && resource.data.roles.get(request.auth.uid, null) == 'director'
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidGame(request.resource.data);

      // Mirrors questionFormSchema in src/features/gameshow/schema.ts.
      match /questions/{questionId} {
        function isValidQuestion(data) {
          return data.text is string
            && data.text.size() > 0
            && data.text.size() <= 1000
            && data.options is list
            && data.options.size() == 4
            && data.correctOptionId in ['A', 'B', 'C', 'D']
            && data.timeLimitSec is int
            && data.timeLimitSec >= 5
            && data.timeLimitSec <= 300
            && data.order is number;
        }

        allow read: if isStaff();
        allow create, update: if isDirector() && isValidQuestion(request.resource.data);
        allow delete: if isDirector();
      }

      // The single document every screen listens to. Director only.
      match /live/{docId} {
        allow read: if isMember();
        allow write: if isDirector();
      }

      match /contestants/{uid} {
        allow read: if isMember();
        allow create, delete: if isDirector();
        // Contestants may only flag that they answered the current question
        // (written in the same batch as the answer).
        allow update: if isDirector()
          || (signedIn()
            && request.auth.uid == uid
            && role() == 'contestant'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['answeredQuestionId'])
            && request.resource.data.answeredQuestionId == live().questionId);
      }

      // One per contestant per question, id `{questionId}_{uid}`.
      match /answers/{answerId} {
        // Contestants may read only their own answer (also before it exists).
        allow read: if isStaff()
          || (isMember() && answerId.matches('.+_' + request.auth.uid));

        // One tap is final: create only, while answering is open and within
        // the time limit measured on the server.
        allow create: if signedIn()
          && role() == 'contestant'
          && request.resource.data.keys().hasOnly(
            ['questionId', 'contestantId', 'optionId', 'answeredAt', 'isCorrect'])
          && request.resource.data.contestantId == request.auth.uid
          && request.resource.data.questionId == live().questionId
          && answerId == live().questionId + '_' + request.auth.uid
          && live().phase == 'answering'
          && request.time < live().openedAt + duration.value(live().timeLimitSec, 's')
          && request.resource.data.optionId in ['A', 'B', 'C', 'D']
          && request.resource.data.answeredAt == request.time
          && request.resource.data.isCorrect == null;

        // The director marks answers right or wrong when revealing.
        allow update: if isDirector()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isCorrect'])
          && request.resource.data.isCorrect is bool;

        allow delete: if isDirector();
      }
    }

    match /customers/{customerId} {
      function signedIn() {
        return request.auth != null;
      }

      function currentUserRef() {
        return /databases/$(database)/documents/users/$(request.auth.uid);
      }

      function customer() {
        return get(/databases/$(database)/documents/customers/$(customerId));
      }

      // Mirrors customerFormSchema in src/features/customers/schema.ts.
      function isValidCustomer(data) {
        return data.name is string
          && data.name.size() > 0
          && data.name.size() <= 200
          && data.email is string
          && data.email.matches('^[^@ ]+@[^@ ]+[.][^@ ]+$')
          && data.status in ['active', 'inactive']
          && data.priority in ['high', 'medium', 'low']
          && data.get('description', '') is string
          && data.get('description', '').size() <= 2000
          && (data.get('assignedTo', null) == null || data.assignedTo is path);
      }

      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.createdBy == currentUserRef()
        && request.resource.data.updatedBy == currentUserRef()
        && isValidCustomer(request.resource.data);

      // Any signed-in user may edit, but must stamp themselves as updatedBy
      // and never change who created it.
      allow update: if signedIn()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedBy == currentUserRef()
        && isValidCustomer(request.resource.data);

      allow delete: if signedIn() && resource.data.createdBy == currentUserRef();

      match /activities/{activityId} {
        // Mirrors activityFormSchema in src/features/customers/schema.ts.
        // Fields that don't apply to the type are stored as null.
        function isValidActivity(data) {
          return data.type in ['call', 'email', 'meeting', 'note']
            && data.date is timestamp
            && (data.type == 'call'
              ? data.get('callQuality', null) == null
                || data.callQuality in ['good', 'average', 'poor']
              : data.get('content', null) is string
                && data.content.size() > 0
                && data.content.size() <= 5000)
            && (data.get('note', null) == null
              || (data.note is string && data.note.size() <= 2000));
        }

        allow read: if signedIn();

        allow create: if signedIn()
          && exists(/databases/$(database)/documents/customers/$(customerId))
          && request.resource.data.createdBy == currentUserRef()
          && request.resource.data.updatedBy == currentUserRef()
          && isValidActivity(request.resource.data);

        // Only the author may edit their activity.
        allow update: if signedIn()
          && resource.data.createdBy == currentUserRef()
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedBy == currentUserRef()
          && isValidActivity(request.resource.data);

        // The author, or the customer's creator (needed to delete the customer).
        allow delete: if signedIn()
          && (resource.data.createdBy == currentUserRef()
            || customer().data.createdBy == currentUserRef());
      }

      // Metadata for files stored in Storage (see storage.rules). Immutable.
      match /files/{fileId} {
        function isValidFile(data) {
          return data.name is string
            && data.name.size() > 0
            && data.name.size() <= 500
            && data.url is string
            && data.contentType is string
            && data.size is int
            && data.size <= 10 * 1024 * 1024
            && data.storagePath is string
            && data.storagePath.matches('customers/' + customerId + '/files/' + fileId + '-.+')
            && data.uploadedAt == request.time;
        }

        allow read: if signedIn();

        allow create: if signedIn()
          && exists(/databases/$(database)/documents/customers/$(customerId))
          && request.resource.data.uploadedBy == currentUserRef()
          && isValidFile(request.resource.data);

        // The uploader, or the customer's creator (needed to delete the customer).
        allow delete: if signedIn()
          && (resource.data.uploadedBy == currentUserRef()
            || customer().data.createdBy == currentUserRef());
      }
    }
  }
}
