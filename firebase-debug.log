[debug] [2026-10-07T14:38:04.956Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/batch08-59043/rulesets {"name":"projects/batch08-59043/rulesets/e1c68395-13f7-4846-b9d1-3d5afa49fc78","source":{"files":[{"content":"rules_version = '2';\n\nservice firebase.storage {\n  match /b/{bucket}/o {\n    // Customer attachments; each has a document in customers/{id}/files.\n    // firestore.get()/exists() need the Storage service agent to have\n    // roles/firebaserules.firestoreServiceAgent; `firebase deploy` offers to grant it\n    // when the rules change (skipped with --non-interactive).\n    match /customers/{customerId}/files/{fileName} {\n      function signedIn() {\n        return request.auth != null;\n      }\n\n      function customerPath() {\n        return /databases/(default)/documents/customers/$(customerId);\n      }\n\n      allow read: if signedIn();\n\n      // Keep the size limit in sync with MAX_FILE_SIZE in types.ts.\n      allow create: if signedIn()\n        && firestore.exists(customerPath())\n        && request.resource.size <= 10 * 1024 * 1024\n        && request.resource.metadata.uploadedBy == request.auth.uid;\n\n      // The uploader, or the customer's creator (needed to delete the customer).\n      allow delete: if signedIn()\n        && (resource.metadata.uploadedBy == request.auth.uid\n          || firestore.get(customerPath()).data.createdBy\n            == /databases/(default)/documents/users/$(request.auth.uid));\n    }\n  }\n}\n","name":"storage.rules"}]},"createTime":"2026-10-07T14:38:04.846447Z","metadata":{"services":["firebase.storage"]}}
